DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# منع الوصول المباشر لملفات الإعداد والتضمين
<FilesMatch "\.(sql|md)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

Options -Indexes
